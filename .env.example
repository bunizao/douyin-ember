# Login: a cookie JSON array (inline or a file path) or a Playwright storage state
DOUYIN_COOKIE=cookie.json
# DOUYIN_STORAGE_STATE=storage-state.json

TASK_CONFIG=config.json
ARTIFACTS_DIR=artifacts

HEADLESS=false
# BROWSER_PATH=/usr/bin/chromium

# Record a Playwright trace (screenshots and DOM snapshots) and keep it on failure
TRACE=false

# DingTalk bot (optional; set both)
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=SECxxx

# Generic webhook (optional)
# WEBHOOK_URL=https://example.com/webhook
# Headers as JSON or key=value pairs: Authorization=Bearer token,X-Custom=value
# WEBHOOK_HEADERS={"Content-Type": "application/json"}
# JSON body template. Variables: {task_id}, {mode}, {status}, {success_count},
# {failed_count}, {total_count}, {timestamp}, {results_json}
# WEBHOOK_TEMPLATE={"text": "Task {task_id} finished", "status": "{status}", "success": {success_count}, "failed": {failed_count}}
