# One file per account in multi-account mode: copy to .env.account1, .env.account2, ...
# and point env_file in config/accounts.json at it.
# Login and task keys are per account; everything else is inherited from .env.
DOUYIN_COOKIE=cookie-account1.json
TASK_CONFIG=config/tasks/account1.json
# DOUYIN_STORAGE_STATE=storage_state/account1.json  (takes precedence over DOUYIN_COOKIE)
# ARTIFACTS_DIR=artifacts/account1                   (default: artifacts/<account id>)

# Per-account DingTalk bot (optional)
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
