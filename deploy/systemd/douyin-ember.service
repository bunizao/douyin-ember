[Unit]
Description=Douyin Ember
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=douyin-ember
Group=douyin-ember
WorkingDirectory=/opt/douyin-ember
Environment=HEADLESS=true
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/douyin-ember/.playwright
ExecStart=/opt/douyin-ember/.venv/bin/python run.py
TimeoutStartSec=60min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/douyin-ember/artifacts
